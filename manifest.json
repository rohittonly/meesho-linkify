{
  "manifest_version": 3,
  "name": "Meesho Linkify",
  "description": "Generate your own Meesho affiliate links in one click.",
  "version": "0.1.0",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://www.meesho.com/*",
    "https://affiliate.meesho.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Meesho Linkify"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.meesho.com/*"],
      "js": ["content.js"]
    }
  ]
}